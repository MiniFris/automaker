{
  "name": "@automaker/server",
  "version": "1.0.0",
  "description": "Backend server for Automaker - provides API for both web and Electron modes",
  "author": "AutoMaker Team",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "engines": {
    "node": ">=22.22.3 <23.0.0"
  },
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:test": "tsx src/main.ts",
    "dev:e2e": "tsx tests/e2e-server.ts",
    "build": "node scripts/clean-build.mjs && tsc && node scripts/check-build.mjs",
    "start": "node dist/main.js",
    "lint": "eslint src/",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:cov": "npm run test:coverage",
    "test:coverage": "vitest run --config vitest.coverage.config.ts --coverage",
    "test:watch": "vitest watch",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:ssh": "vitest run --config vitest.ssh.config.ts",
    "test:docker": "vitest run --config vitest.docker.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.2.32",
    "@automaker/contracts": "1.0.0",
    "@automaker/dependency-resolver": "1.0.0",
    "@automaker/git-utils": "1.0.0",
    "@automaker/model-resolver": "1.0.0",
    "@automaker/platform": "1.0.0",
    "@automaker/prompts": "1.0.0",
    "@automaker/types": "1.0.0",
    "@automaker/utils": "1.0.0",
    "@github/copilot-sdk": "0.2.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@openai/codex-sdk": "^0.98.0",
    "ajv": "8.20.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "fflate": "0.8.3",
    "morgan": "1.12.1",
    "node-pty": "1.1.0-beta41",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ssh2": "1.17.0",
    "ws": "8.22.0",
    "yaml": "2.9.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@nestjs/testing": "12.2.0",
    "@playwright/test": "1.57.0",
    "@types/cookie": "0.6.0",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/morgan": "1.9.10",
    "@types/node": "22.19.3",
    "@types/ssh2": "1.15.5",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "4.1.12",
    "@vitest/ui": "4.1.12",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
