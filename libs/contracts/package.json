{
  "name": "@automaker/contracts",
  "version": "1.0.0",
  "type": "module",
  "description": "Runtime transport schemas shared by Automaker clients and servers",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./domains/*": {
      "types": "./dist/domains/*.d.ts",
      "default": "./dist/domains/*.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "dependencies": {
    "zod": "4.6.6",
    "@automaker/types": "1.0.0"
  },
  "devDependencies": {
    "@types/node": "22.19.3",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "private": true
}
